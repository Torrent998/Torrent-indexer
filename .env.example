# Non-secret configuration. The indexer only reads public chain data; no keys are needed.
STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Torrent escrow on Stellar Testnet: CBWF73FUJDGXSXOYUVYHP3XAFSPZWX65YGFSXDSSF5VRFLEWFFTQUIJG (deployed in ledger 5553711, see Torrent-contracts/deployments/).
TORRENT_ESCROW_CONTRACT_ID=
CHAIN_START_LEDGER=0
CONFIRMATIONS=1
PAGE_SIZE=100
POLL_MS=5000
PORT=3002
DATABASE_PATH=data/indexer.db
LOG_LEVEL=info
RECONCILE_EVERY_TICKS=60
# Allowed CORS origin for the public read-only API (defaults to * because responses contain no per-caller data).
CORS_ALLOWED_ORIGIN=*
