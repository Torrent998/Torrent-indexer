# Non-secret configuration. The indexer only reads public chain data; no keys are needed.
STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Set after a Testnet deployment of torrent-contracts (see its deployments/README.md). No deployment exists yet.
TORRENT_ESCROW_CONTRACT_ID=
CHAIN_START_LEDGER=0
CONFIRMATIONS=1
PAGE_SIZE=100
POLL_MS=5000
PORT=3002
STATE_FILE=data/state.json
LOG_LEVEL=info
RECONCILE_EVERY_TICKS=60
