{
  "schema": "torrent.synthetic-scenario",
  "abiVersion": 2,
  "description": "Logical script replayed by torrent-escrow tests; torrent-indexer replays the equivalent event stream (stream.v2.json, same step names) to prove identical projection. Actors are labels, not addresses. Amounts are integer base units of a synthetic Testnet token.",
  "steps": [
    { "call": "create_pool", "emits": ["pool_created"] },
    { "call": "allow_member+join_pool", "who": "alice", "emits": ["member_joined"] },
    { "call": "allow_member+join_pool", "who": "bob", "emits": ["member_joined"] },
    { "call": "deposit", "who": "controller", "amount": "1000", "emits": ["funded"] },
    { "call": "issue_right", "to": "alice", "amount": "600", "maturityOffsetDays": 30, "emits": ["right_issued"] },
    { "call": "propose_transfer", "right": 1, "to": "bob", "emits": ["transfer_proposed"] },
    { "call": "accept_transfer", "transfer": 1, "emits": ["transfer_completed"] },
    { "call": "advance_days", "days": 30, "emits": [] },
    { "call": "claim", "right": 1, "recipient": "bob", "emits": ["right_claimed"] },
    { "call": "issue_right", "to": "alice", "amount": "100", "emits": ["right_issued"] },
    { "call": "propose_transfer", "right": 2, "to": "bob", "emits": ["transfer_proposed"] },
    { "call": "cancel_transfer", "transfer": 2, "emits": ["transfer_cancelled"] },
    { "call": "withdraw_unreserved", "amount": "300", "emits": ["unreserved_withdrawn"] },
    { "call": "pause_pool", "emits": ["pool_paused"] },
    { "call": "unpause_pool", "emits": ["pool_unpaused"] },
    { "call": "deposit", "who": "alice", "amount": "200", "emits": ["funded"] },
    { "call": "issue_right", "to": "alice", "amount": "50", "emits": ["right_issued"] },
    { "call": "propose_transfer", "right": 3, "to": "bob", "emits": ["transfer_proposed"] },
    { "call": "advance_days+propose_transfer", "right": 3, "to": "bob", "note": "replaces the expired proposal", "emits": ["transfer_cancelled", "transfer_proposed"] },
    { "call": "advance_days+claim", "right": 3, "recipient": "alice", "note": "voids the open proposal", "emits": ["transfer_cancelled", "right_claimed"] },
    { "call": "leave_pool", "who": "bob", "emits": ["member_left"] },
    { "call": "propose_controller", "to": "outsider", "emits": ["controller_proposed"] },
    { "call": "accept_controller", "who": "outsider", "emits": ["controller_changed"] },
    { "call": "close_pool", "emits": ["pool_closed"] },
    { "call": "create_pool", "pool": 2, "emits": ["pool_created"] },
    { "call": "allow_member+join_pool", "pool": 2, "who": "carol", "emits": ["member_joined"] },
    { "call": "remove_member", "pool": 2, "who": "carol", "emits": ["member_removed"] },
    { "call": "propose_admin", "to": "carol", "emits": ["admin_proposed"] },
    { "call": "accept_admin", "who": "carol", "emits": ["admin_changed"] },
    { "call": "propose_upgrade", "emits": ["upgrade_proposed"] },
    { "call": "cancel_upgrade", "emits": ["upgrade_cancelled"] },
    { "call": "propose_upgrade", "emits": ["upgrade_proposed"] },
    { "call": "lock_upgrades", "note": "cancels the pending upgrade", "emits": ["upgrade_cancelled", "upgrades_locked"] }
  ],
  "expectedFinal": {
    "pool1": { "status": "Closed", "controller": "outsider", "members": ["alice"] },
    "totals": { "funded": "1200", "reserved": "100", "claimed": "650", "withdrawn": "300" },
    "right1": { "owner": "bob", "state": "Claimed", "amount": "600" },
    "governance": { "admin": "carol", "upgradesLocked": true, "pendingUpgrade": null },
    "notRecorded": ["contract_upgraded (needs real wasm bytes; covered by tests/governance.rs)"]
  }
}
